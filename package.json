{
  "name": "oh-my-tool",
  "version": "0.3.2",
  "private": true,
  "type": "module",
  "packageManager": "npm@10.9.2",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test && npm run pack:check",
    "pack:check": "npm pack --workspace=@oh-my-tool/sdk --dry-run && npm pack --workspace=@oh-my-tool/cli --dry-run",
    "version:release": "node scripts/set-release-version.mjs"
  },
  "devDependencies": {
    "bun-types": "^1.3.14",
    "typescript": "^5.9.2"
  }
}
